{
  "name": "mindflow-desktop",
  "version": "1.0.0",
  "description": "MindFlow local-first desktop whiteboard and MCP server",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "mcp": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ui/tailwind.css -o ui/utilities.css --minify",
    "pack:linux": "electron-builder --linux dir",
    "pack:win": "electron-builder --win zip --x64",
    "pack:mac": "electron-builder --mac zip",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:css && npm run build:web",
    "test:web": "node tests/web.smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.17.1",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "tailwindcss": "3.4.19"
  },
  "build": {
    "appId": "local.mindflow.desktop",
    "productName": "MindFlow",
    "asar": true,
    "files": [
      "src/**",
      "ui/**",
      "examples/**",
      "package.json",
      "README.md",
      "VALIDATION.md"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "dir",
      "category": "Office"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.productivity"
    }
  }
}